---
import { getCollection } from 'astro:content';
import Post from '../../layouts/Post.astro';
import type { Post as PostEntry } from '../../lib/links';

export async function getStaticPaths() {
  // Drafts never build in production; they do build locally so authors can preview.
  const posts = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const ids = new Set(posts.map((p) => p.id));

  // Fail the build loudly on structural mistakes — a broken hub/spoke graph
  // must never reach Cloudflare Pages.
  for (const p of posts) {
    if (p.data.slug !== p.id) {
      throw new Error(`[posts] "${p.id}.md": frontmatter slug "${p.data.slug}" must equal the file name.`);
    }
    if (p.data.type === 'spoke') {
      if (!p.data.hub) throw new Error(`[posts] spoke "${p.id}" has no hub.`);
      if (!ids.has(p.data.hub)) throw new Error(`[posts] spoke "${p.id}" points at hub "${p.data.hub}", which does not exist (or is a draft in production).`);
      const hub = posts.find((h) => h.id === p.data.hub)!;
      if (hub.data.type !== 'hub') throw new Error(`[posts] spoke "${p.id}" points at "${p.data.hub}", which is not a hub.`);
      if (hub.data.cluster !== p.data.cluster) throw new Error(`[posts] spoke "${p.id}" (cluster ${p.data.cluster}) and hub "${hub.id}" (cluster ${hub.data.cluster}) disagree.`);
    } else if (p.data.hub) {
      throw new Error(`[posts] hub "${p.id}" must have hub: null.`);
    }
    for (const r of p.data.related) {
      if (!ids.has(r)) throw new Error(`[posts] "${p.id}" lists related "${r}", which does not exist.`);
    }
  }

  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: posts } }));
}

interface Props {
  entry: PostEntry;
  all: PostEntry[];
}
const { entry, all } = Astro.props;
---

<Post entry={entry} all={all} />
