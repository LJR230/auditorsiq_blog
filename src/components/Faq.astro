---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="faq" aria-label="Frequently asked questions" style="margin-top: 40px;">
    <h2 style="font-size: 1.375rem; margin: 0 0 12px;">Frequently asked questions</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
